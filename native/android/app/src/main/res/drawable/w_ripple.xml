<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback for widget rows and buttons: a soft grey ripple that reads on both light and dark cards. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#66808088">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
