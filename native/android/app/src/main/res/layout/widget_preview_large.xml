<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (Android 12–14; 15+ uses the generated Glance preview). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/w_preview_card">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  Learning Swift"
        android:textColor="@color/w_fg" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Since 19:06"
        android:textColor="@color/w_muted" android:textSize="13sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="47:00"
            android:textColor="@color/w_fg" android:textSize="40sp" android:fontFeatureSettings="tnum"/>
        <TextView android:layout_width="wrap_content" android:layout_height="38dp" android:paddingHorizontal="16dp" android:gravity="center"
            android:text="■  Stop" android:background="@drawable/w_preview_stop" android:textColor="@color/w_stop_fg"
            android:textSize="15sp" android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="10dp" android:background="@color/w_line"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Tasks" android:textColor="@color/w_fg" android:textSize="14sp" android:maxLines="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today 3h 12m" android:textColor="@color/w_muted" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="●  Code review" android:textColor="@color/w_fg" android:textSize="14sp" android:maxLines="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1h 10m" android:textColor="@color/w_muted" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="●  Bombay kitchen hub" android:textColor="@color/w_fg" android:textSize="14sp" android:maxLines="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45m" android:textColor="@color/w_muted" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="●  Emails &amp; admin" android:textColor="@color/w_fg" android:textSize="14sp" android:maxLines="1"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30m" android:textColor="@color/w_muted" android:textSize="13sp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="@color/w_line"/>
    <ImageView android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:src="@drawable/w_preview_heat" android:importantForAccessibility="no"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Last 20 weeks" android:textColor="@color/w_muted" android:textSize="12sp"/>
</LinearLayout>
