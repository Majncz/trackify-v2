<?xml version="1.0" encoding="utf-8"?>
<!-- The old state stays fully opaque under the fading-in new one, so the card never dips to the wallpaper. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:fromAlpha="1" android:toAlpha="1" android:duration="260" />
</set>
