<?xml version="1.0" encoding="utf-8"?>
<!-- The new widget state fades in and settles up from a few pixels below. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_quad">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="260" />
    <translate android:fromYDelta="4%p" android:toYDelta="0" android:duration="260" />
</set>
